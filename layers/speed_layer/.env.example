# Speed Layer Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# Reddit Scraping (No Auth Required!)
# ========================================
# Uses public .json endpoints - no API credentials needed
REDDIT_USER_AGENT=MovieAnalytics/1.0

# ========================================
# Kafka Configuration (3-broker cluster)
# ========================================
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Cassandra Configuration
CASSANDRA_HOSTS=cassandra
CASSANDRA_KEYSPACE=speed_layer

# MongoDB Configuration
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGO_DATABASE=moviedb
